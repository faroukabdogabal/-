rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Exclusive Master Administrator Gate: Only verified farouk.gabal@gmail.com holds authority
    function isMasterAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'farouk.gabal@gmail.com';
    }

    // Blueprint Validation Helpers (synchronized verbatim with firebase-blueprint.json)
    function isValidSiteConfig(data) {
      return data.keys().hasAll([
          'siteTitle',
          'sadaqahLabel',
          'heroHeadline',
          'heroSubtitle',
          'announcementBanner',
          'defaultSurahId',
          'defaultFromAyah',
          'defaultToAyah',
          'defaultReciterId',
          'defaultBackgroundId',
          'allowPublicCustomSadaqah',
          'isPublishedLive',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'siteTitle',
          'sadaqahLabel',
          'heroHeadline',
          'heroSubtitle',
          'announcementBanner',
          'defaultSurahId',
          'defaultFromAyah',
          'defaultToAyah',
          'defaultReciterId',
          'defaultBackgroundId',
          'allowPublicCustomSadaqah',
          'isPublishedLive',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ])
        && data.siteTitle is string && data.siteTitle.size() >= 2 && data.siteTitle.size() <= 80
        && data.sadaqahLabel is string && data.sadaqahLabel.size() >= 2 && data.sadaqahLabel.size() <= 120
        && data.heroHeadline is string && data.heroHeadline.size() >= 5 && data.heroHeadline.size() <= 180
        && data.heroSubtitle is string && data.heroSubtitle.size() >= 10 && data.heroSubtitle.size() <= 350
        && data.announcementBanner is string && data.announcementBanner.size() <= 240
        && data.defaultSurahId is int && data.defaultSurahId >= 1 && data.defaultSurahId <= 114
        && data.defaultFromAyah is int && data.defaultFromAyah >= 1 && data.defaultFromAyah <= 286
        && data.defaultToAyah is int && data.defaultToAyah >= data.defaultFromAyah && data.defaultToAyah <= 286 && data.defaultToAyah <= data.defaultFromAyah + 29
        && data.defaultReciterId is string && data.defaultReciterId.size() >= 2 && data.defaultReciterId.size() <= 60 && data.defaultReciterId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.defaultBackgroundId is string && data.defaultBackgroundId.size() >= 2 && data.defaultBackgroundId.size() <= 60 && data.defaultBackgroundId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.allowPublicCustomSadaqah is bool
        && data.isPublishedLive is bool
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') && data.ownerUid == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublishedPreset(data) {
      return data.keys().hasAll([
          'titleArabic',
          'subtitleArabic',
          'surahId',
          'fromAyah',
          'toAyah',
          'reciterId',
          'backgroundId',
          'status',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'titleArabic',
          'subtitleArabic',
          'surahId',
          'fromAyah',
          'toAyah',
          'reciterId',
          'backgroundId',
          'status',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ])
        && data.titleArabic is string && data.titleArabic.size() >= 2 && data.titleArabic.size() <= 80
        && data.subtitleArabic is string && data.subtitleArabic.size() >= 2 && data.subtitleArabic.size() <= 60
        && data.surahId is int && data.surahId >= 1 && data.surahId <= 114
        && data.fromAyah is int && data.fromAyah >= 1 && data.fromAyah <= 286
        && data.toAyah is int && data.toAyah >= data.fromAyah && data.toAyah <= 286 && data.toAyah <= data.fromAyah + 29
        && data.reciterId is string && data.reciterId.size() >= 2 && data.reciterId.size() <= 60 && data.reciterId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.backgroundId is string && data.backgroundId.size() >= 2 && data.backgroundId.size() <= 60 && data.backgroundId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.status is string && data.status.size() <= 16 && (data.status == 'published' || data.status == 'draft')
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') && data.ownerUid == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminProfile(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'roleSummary',
          'permissions',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'roleSummary',
          'permissions',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120 && data.email == 'farouk.gabal@gmail.com'
        && data.roleSummary is string && data.roleSummary.size() >= 5 && data.roleSummary.size() <= 200
        && data.permissions is string && data.permissions.size() <= 80 && data.permissions == 'ALL_PERMISSIONS_OWNER_AGENT_MANAGER_ADMIN_EDITOR_PUBLISHER'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 1. Singleton Site Configuration (/site_config/main)
    match /site_config/{configId} {
      allow get: if isValidId(configId) && configId == 'main';
      allow list: if false;

      allow create: if isMasterAdmin()
        && isValidId(configId)
        && configId == 'main'
        && isValidSiteConfig(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(configId)
        && configId == 'main'
        && isValidSiteConfig(incoming())
        && isMasterAdmin()
        && incoming().createdAt == existing().createdAt
        && incoming().ownerUid == existing().ownerUid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'siteTitle',
          'sadaqahLabel',
          'heroHeadline',
          'heroSubtitle',
          'announcementBanner',
          'defaultSurahId',
          'defaultFromAyah',
          'defaultToAyah',
          'defaultReciterId',
          'defaultBackgroundId',
          'allowPublicCustomSadaqah',
          'isPublishedLive',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // 2. Curated Quranic Passages (/published_presets/{presetId})
    match /published_presets/{presetId} {
      allow get: if isValidId(presetId) && (existing().status == 'published' || isMasterAdmin());
      allow list: if existing().status == 'published' || isMasterAdmin();

      allow create: if isMasterAdmin()
        && isValidId(presetId)
        && isValidPublishedPreset(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(presetId)
        && isValidPublishedPreset(incoming())
        && isMasterAdmin()
        && incoming().createdAt == existing().createdAt
        && incoming().ownerUid == existing().ownerUid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'titleArabic',
          'subtitleArabic',
          'surahId',
          'fromAyah',
          'toAyah',
          'reciterId',
          'backgroundId',
          'status',
          'updatedAt'
        ]);

      allow delete: if isMasterAdmin() && isValidId(presetId);
    }

    // 3. PII-Isolated Master Administrator Profile (/admins/{adminUid})
    match /admins/{adminUid} {
      allow get: if isMasterAdmin() && isValidId(adminUid) && request.auth.uid == adminUid;
      allow list: if false;

      allow create: if isMasterAdmin()
        && isValidId(adminUid)
        && request.auth.uid == adminUid
        && isValidAdminProfile(incoming())
        && incoming().uid == adminUid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(adminUid)
        && request.auth.uid == adminUid
        && isValidAdminProfile(incoming())
        && isMasterAdmin()
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'roleSummary',
          'permissions',
          'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
